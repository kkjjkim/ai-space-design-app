# ⭐ 사용법: 이 파일을 복사해서 이름을 ".env" 로 바꾸고, 아래 값만 채우세요.
#    (터미널)  cp arbitrage/.env.example arbitrage/.env
#    그다음 따옴표 안에 발급받은 키를 붙여넣으면 끝. .env 는 깃에 안 올라갑니다.

# ── 네이버 쇼핑 검색 API (한국 원가 자동수집 / 필수) ──────────────
# 발급: https://developers.naver.com > 애플리케이션 등록 > 사용 API "검색" 선택
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ── eBay Browse API (해외 판매가 발굴 / 선택) ────────────────────
# 발급: https://developer.ebay.com > 무료 개발자 계정 > Application Keys (Production)
# 셀러 계정 필요 없음. --source=ebay 쓸 때만 필요.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
